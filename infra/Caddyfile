{
	auto_https disable_redirects
}

https://localhost:8443, https://{$MBAS_LAN_IP}:8443 {
	tls internal

	handle /rtc* {
		reverse_proxy livekit:7880
	}
	handle /api/* {
		reverse_proxy host.docker.internal:{$MBAS_API_PORT}
	}
	handle {
		reverse_proxy host.docker.internal:{$MBAS_WEB_PORT}
	}
}

# Product (Stage 9): candidate + interviewer apps on https://<LAN_IP>:8444
https://localhost:8444, https://{$MBAS_LAN_IP}:8444 {
	tls internal

	handle /rtc* {
		reverse_proxy livekit:7880
	}
	handle /api/* {
		reverse_proxy host.docker.internal:{$MBAS_APP_API_PORT}
	}
	handle /ws/* {
		reverse_proxy host.docker.internal:{$MBAS_APP_API_PORT}
	}
	handle /metrics {
		reverse_proxy host.docker.internal:{$MBAS_APP_API_PORT}
	}
	handle {
		reverse_proxy host.docker.internal:{$MBAS_APP_WEB_PORT}
	}
}
