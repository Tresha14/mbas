# Data: recorded sessions contain personal data (DPDP Act 2023) - never commit them.
data/raw/*
!data/raw/.gitkeep
!data/raw/mbas_synthetic_dataset/
data/processed/*
!data/processed/.gitkeep
# tokenizers are tiny and must match the trained checkpoints on every laptop
!data/processed/tokenizers/
data/processed/tokenizers/*
!data/processed/tokenizers/*.model
!data/processed/tokenizers/*.vocab

# Training outputs
runs/*
!runs/.gitkeep
checkpoints/
*.ckpt
*.pt
*.onnx

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# trained-model bundle shared by the team (extract into the repo root, never commit)
mbas_models_*.zip
