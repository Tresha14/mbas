# Copy to .env and edit. docker compose and the recorder backend both read it.

# LAN IP of the laptop that runs docker compose (ipconfig -> IPv4 Address).
# Use 127.0.0.1 when both browser windows are on the same laptop.
MBAS_LAN_IP=127.0.0.1

# LiveKit dev credentials (must match infra/livekit.yaml). Secret must be >= 32 chars.
LIVEKIT_API_KEY=mbasdevkey
LIVEKIT_API_SECRET=mbas_dev_secret_change_me_0123456789abcdef

# Host ports (chosen to avoid clashing with other local projects on 3000/5432/6379/8000).
MBAS_PG_PORT=5442
MBAS_REDIS_PORT=6389
MBAS_API_PORT=8010
MBAS_WEB_PORT=3010

POSTGRES_USER=mbas
POSTGRES_PASSWORD=mbas
POSTGRES_DB=mbas
DATABASE_URL=postgresql://mbas:mbas@localhost:5442/mbas
REDIS_URL=redis://localhost:6389/0

# Where the recorder writes sessions (relative to the repo root).
MBAS_RAW_DIR=data/raw

# Label Studio (Stage 2 annotation): docker compose --profile labelling up -d labelstudio
MBAS_LABELSTUDIO_PORT=8090
LABEL_STUDIO_URL=http://localhost:8090
LABEL_STUDIO_USERNAME=admin@mbas.local
LABEL_STUDIO_PASSWORD=mbas-labelling
# Optional personal access token; when empty the tools log in with the username/password above.
LABEL_STUDIO_TOKEN=
